---
/**
 * The motif, as a section divider.
 *
 * A hand thrown scatter of sesame. The positions and angles come from a
 * fixed seed so the mark is identical on every build and every page, but
 * irregular enough that it never reads as a repeating pattern swatch. That
 * irregularity is the whole point: it is what the real tray looks like.
 */
interface Props {
  /** How many seeds across. More reads as a fresh tray, fewer as a rest. */
  density?: "sparse" | "normal" | "dense";
  class?: string;
  /** Decorative by default. Give it a label only if it carries meaning. */
  label?: string;
}

const { density = "normal", class: className = "", label } = Astro.props;

const COUNT = { sparse: 9, normal: 16, dense: 26 }[density];
const W = 1000;
const H = 26;

/* A tiny deterministic generator. Seeded, so the scatter never shifts. */
function makeRandom(seed: number) {
  let state = seed >>> 0;
  return () => {
    state = (state * 1664525 + 1013904223) >>> 0;
    return state / 0x100000000;
  };
}

const rand = makeRandom(0x5e5a3e); /* "sesame" */
const seeds = Array.from({ length: COUNT }, (_, i) => {
  /* Spread across the band, then jitter, so the spacing is uneven. */
  const slot = (i + 0.5) * (W / COUNT);
  return {
    x: slot + (rand() - 0.5) * (W / COUNT) * 1.15,
    y: H / 2 + (rand() - 0.5) * H * 0.62,
    angle: rand() * 180,
    /* Real sesame varies in size. A uniform scatter looks printed. */
    rx: 3.6 + rand() * 1.5,
    ry: 1.9 + rand() * 0.6,
    opacity: 0.55 + rand() * 0.45,
  };
});
---

<svg
  class={`seed-divider ${className}`}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="none"
  role={label ? "img" : "presentation"}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
>
  {
    seeds.map((s) => (
      <ellipse
        cx={s.x.toFixed(1)}
        cy={s.y.toFixed(1)}
        rx={s.rx.toFixed(2)}
        ry={s.ry.toFixed(2)}
        opacity={s.opacity.toFixed(2)}
        transform={`rotate(${s.angle.toFixed(1)} ${s.x.toFixed(1)} ${s.y.toFixed(1)})`}
      />
    ))
  }
</svg>

<style>
  .seed-divider {
    display: block;
    width: 100%;
    height: 1.35rem;
    fill: var(--seed-ink);
    /* Fade the ends so the line sits in the page rather than hitting the
       gutters like a horizontal rule. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 15%, #000 85%, transparent);
  }
</style>

---
/**
 * Questions. The index.
 *
 * Every question on this site is its own page, generated from
 * `src/content/faq/`. This page is the way in: four groups, every question
 * linked, and the short answer under each one so that somebody who came here
 * to check a single fact can leave without a second click.
 *
 * WHY THIS IS NOT A LIST OF FRAGMENTS ANY MORE
 *
 * It used to be one page with fourteen headings and a jump list. To a search
 * engine that is one URL: one title, one description, one position, one thing
 * to share. A person searching "how long does gata keep" got the whole FAQ or
 * nothing. Each answer now carries a title and a description written for that
 * question. See docs/DECISIONS.md D-008.
 *
 * THE OLD FRAGMENTS STILL WORK. A fragment never reaches the server, so no
 * redirect can catch `/faq#delivery`. Instead every question on this index
 * keeps the id it had, so an old link lands here, scrolled to that question,
 * next to the link to its page. `legacyAnchor` covers the two whose slug was
 * improved on the way across.
 *
 * SiteFooter.astro still links to `/faq#delivery` and `/faq#lead-time`, so
 * those two ids remain load bearing until that file is changed to point at
 * `/faq/delivery/` and `/faq/lead-time/`. It is owned elsewhere. Nothing here
 * breaks either way, because the ids are generated from the slugs.
 */
import { getCollection } from "astro:content";

import Base from "@layouts/Base.astro";
import Button from "@components/Button.astro";
import SeedRule from "@components/SeedRule.astro";
import { business, storeOpen } from "@config/site";
import {
  FAQ_GROUPS,
  buildAnswerContext,
  checkedQuestions,
  fillText,
  questionHref,
  type FaqEntry,
} from "./faq/_answers";

const ctx = await buildAnswerContext();
const questions = checkedQuestions(await getCollection("faq"));

const grouped = FAQ_GROUPS.map((group) => ({
  ...group,
  questions: questions.filter((entry) => entry.data.group === group.id),
})).filter((group) => group.questions.length > 0);

const shortAnswer = (entry: FaqEntry): string =>
  fillText(entry.data.short, ctx, `src/content/faq/${entry.id}.md, short`);
---

<Base
  title="Questions"
  description="Allergens, storage, lead times, pickup, local delivery and shipping inside California, and what it means that gata is baked in a home kitchen under cottage food law."
>
  <article class="faq">
    <div class="page band--tight">
      <div class="prose-col">
        <h1>Questions</h1>
        <p class="faq__lede">
          The things people ask before they order. Every one of them is its own
          page, so a single answer can be sent to a single person. Where the
          answer has not been decided yet, this page says so rather than
          inventing a number.
        </p>
      </div>
    </div>

    <SeedRule density="normal" />

    {
      grouped.map((group, index) => (
        <>
          {index > 0 && <SeedRule density="sparse" />}
          <section class="page band--tight" aria-labelledby={`group-${group.id}`}>
            <div class="prose-col">
              <h2 id={`group-${group.id}`} class="faq__group-title">
                {group.heading}
              </h2>
              <p class="faq__group-blurb">{group.blurb}</p>
            </div>

            <ul class="faq__list prose-col">
              {group.questions.map((entry) => (
                <li class="faq__item" id={entry.data.legacyAnchor}>
                  <h3 class="faq__question" id={entry.data.slug}>
                    <a class="faq__link" href={questionHref(entry.data.slug)}>
                      {entry.data.question}
                    </a>
                  </h3>
                  <p class="faq__short">{shortAnswer(entry)}</p>
                </li>
              ))}
            </ul>
          </section>
        </>
      ))
    }

    <div class="page band--tight faq__foot">
      <div class="prose-col">
        <h2 class="faq__foot-title">Still stuck?</h2>
        <p>
          Ask. It goes to {business.owner} and he answers it himself.
        </p>
        <p class="faq__actions">
          <Button href="/contact" variant="secondary">Contact Hakop</Button>
          {
            storeOpen ? (
              <Button href="/shop" variant="primary">
                See the trays
              </Button>
            ) : (
              <Button href="/#waitlist" variant="primary">
                Tell me when ordering opens
              </Button>
            )
          }
        </p>
      </div>
    </div>
  </article>
</Base>

<style>
  .faq__lede {
    margin-top: 1rem;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-crust-soft);
  }

  .faq__group-title {
    font-size: var(--text-2xl);
    /* An old /faq#delivery link scrolls to a question, and a question sits
       under its group heading. Both need room above them. */
    scroll-margin-top: 5rem;
  }

  .faq__group-blurb {
    margin-top: 0.4rem;
    color: var(--color-crust-soft);
  }

  /* ---- The questions ---- */

  .faq__list {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .faq__item {
    padding-block: 1rem;
    border-top: 1px solid var(--color-line);
    scroll-margin-top: 5rem;
  }

  .faq__question {
    font-size: var(--text-lg);
    scroll-margin-top: 5rem;
    /* A single seed sits in the gutter beside each question, the same mark
       the rest of the site uses, so the index reads as a tray of them
       rather than a stack of identical cards. */
    position: relative;
  }

  .faq__question::before {
    content: "";
    position: absolute;
    left: -1.15rem;
    top: 0.62em;
    width: 7px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-eggwash);
    transform: rotate(-24deg);
  }

  /* At narrow widths the gutter does not exist, so the seed would sit off
     the left edge of the screen. It goes above the question instead. */
  @media (max-width: 40rem) {
    .faq__question::before {
      left: 0;
      top: -0.5rem;
    }

    .faq__question {
      padding-top: 0.35rem;
    }
  }

  .faq__link {
    /* The whole question is the target, and it is a 44px row. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-link);
    text-decoration: none;
  }

  .faq__link:hover {
    color: var(--color-link-bright);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .faq__short {
    margin-top: 0.15rem;
    color: var(--color-crust-soft);
    max-width: 62ch;
  }

  /* ---- Foot ---- */

  .faq__foot {
    border-top: 1px solid var(--color-line);
  }

  .faq__foot-title {
    font-size: var(--text-xl);
  }

  .faq__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
</style>

---
/**
 * Contact.
 *
 * WHY THIS IS EMAIL AND NOT A FORM.
 *
 * There is no inbox behind a contact form. The only form endpoint that exists
 * is `/api/subscribe`, and it does exactly one thing: it puts an address on
 * the waiting list with a recorded consent. Posting a message into it would
 * either be dropped on the floor or silently subscribe somebody who only
 * wanted to ask a question, and a contact form that quietly loses messages is
 * worse than no contact form at all.
 *
 * So the contact route is a real mailto, presented properly: one address, a
 * short list of reasons people write, and a prefilled subject line for each so
 * that Hakop can see at a glance which ones are about an allergy or an order.
 *
 * The waiting list form does appear on this page while the store is closed,
 * because that is the thing most visitors actually want, and it posts to the
 * endpoint that was built for it.
 *
 * WHEN A REAL FORM BACKEND EXISTS: keep the mailto. Somebody using a keyboard,
 * a screen reader, or a phone with a mail client set up is faster with it than
 * with any form, and it is the one route that cannot break silently.
 */
import Base from "@layouts/Base.astro";
import Button from "@components/Button.astro";
import SeedRule from "@components/SeedRule.astro";
import EmailCapture from "@islands/EmailCapture";
import { business, storeOpen } from "@config/site";

const mail = (subject: string) =>
  `mailto:${business.email}?subject=${encodeURIComponent(subject)}`;

/*
  The subject lines are the sorting mechanism. Hakop is one person reading one
  inbox between shifts, and "Allergen question" in a subject line is the
  difference between an answer today and an answer on Sunday.
*/
const REASONS = [
  {
    subject: "Allergen question",
    label: "A question about allergens",
    detail:
      "Every tray contains wheat, milk, egg, almonds, walnuts and sesame. If you need to know more than that before you order, ask.",
  },
  {
    subject: "Order question",
    label: "A question about an order",
    detail: "Put your order reference in the subject line and it is found straight away.",
  },
  {
    subject: "Delivery and pickup",
    label: "Delivery, pickup or shipping",
    detail: "Whether a tray can reach you, and how, if the postal code check has not answered it.",
  },
  {
    subject: "Hello",
    label: "Something else",
    detail: "Including if something on this site is wrong, broken, or in your way.",
  },
];
---

<Base
  title="Contact"
  description="Write to Hakop directly. One email address, read by the person who bakes. Allergen questions, order questions, delivery, pickup and anything else."
>
  <article class="contact">
    <div class="page band--tight">
      <div class="prose-col">
        <h1>Contact</h1>
        <p class="contact__lede">
          There is one address and {business.owner} reads it himself. No
          ticketing system, no contact form that goes nowhere.
        </p>

        <p class="contact__address">
          <a href={mail("Hello")} class="contact__address-link">{business.email}</a>
        </p>

        <p class="contact__where">
          Baked in {business.city}, California. The kitchen address is not
          published here: it goes to you with your order rather than onto a
          public page.
        </p>
      </div>
    </div>

    <SeedRule density="normal" />

    <section class="page band--tight" aria-labelledby="reasons-title">
      <div class="prose-col">
        <h2 id="reasons-title">What you are writing about</h2>
        <p>
          Any of these opens a new email with the subject already filled in.
          The subject is how one person reading one inbox knows what needs
          answering first.
        </p>
      </div>

      <ul class="reasons prose-col">
        {
          REASONS.map((reason) => (
            <li class="reasons__item">
              <a class="reasons__link" href={mail(reason.subject)}>
                <span class="reasons__seed" aria-hidden="true" />
                <span class="reasons__label">{reason.label}</span>
              </a>
              <p class="reasons__detail">{reason.detail}</p>
            </li>
          ))
        }
      </ul>

      <div class="prose-col contact__note">
        <p>
          If your mail app does not open, the address is{" "}
          <a href={mail("Hello")}>{business.email}</a> and it can be copied by
          hand.
        </p>
      </div>
    </section>

    <section class="page band--tight" aria-labelledby="helpful-title">
      <div class="prose-col">
        <h2 id="helpful-title">What helps him answer quickly</h2>
        <ul class="contact__list">
          <li>Your order reference, if it is about an order.</li>
          <li>The postal code, if it is about delivery or shipping.</li>
          <li>
            What page you were on and what happened, if something on this site
            went wrong.
          </li>
        </ul>
        <p>
          {business.owner} bakes, studies and works a shift schedule, so a
          reply is not instant. An allergy question and a problem with an order
          go before everything else.
        </p>

        {
          business.phone ? (
            <p>
              By phone: <a href={`tel:${business.phone.replace(/[^\d+]/g, "")}`}>{business.phone}</a>.
            </p>
          ) : (
            <p class="contact__open">
              <span class="contact__open-title">There is no phone number.</span>{" "}
              Not an oversight: a one person bakery run around class and work
              cannot answer a phone reliably, and a number nobody picks up is
              worse than no number. Email is the route that works.
            </p>
          )
        }
      </div>
    </section>

    <SeedRule density="sparse" />

    <section class="page band--tight" aria-labelledby="shops-title">
      <div class="prose-col">
        <h2 id="shops-title">Shops, cafes and resellers</h2>
        <p>
          A Class A Cottage Food Operation may only sell directly to the person
          who is going to eat the food, so there is no wholesale and no supply
          to a shop or a cafe. That is California law, not a policy, and asking
          nicely cannot change it.
        </p>
        <p>
          Buying trays for an office, a party or an event is direct selling and
          is completely fine. Write and say how many and when.
        </p>
      </div>
    </section>

    {
      !storeOpen && (
        <div class="page band--tight">
          <div class="prose-col">
            {/*
              The island renders its own section and its own heading, so it is
              not wrapped in a second one. It is the only form on this page and
              it posts to /api/subscribe, which is the endpoint built for it.
            */}
            <EmailCapture
              client:visible
              source="contact"
              id="waitlist"
              headingLevel={2}
              title="Hear when ordering opens"
              lede="Leave an email and you will hear once, on the day the county number arrives and the trays go on sale. That is all this form does."
              contactEmail={business.email}
              privacyHref="/legal/privacy"
            />
          </div>
        </div>
      )
    }

    <div class="page band--tight contact__foot">
      <div class="prose-col">
        <h2 class="contact__foot-title">Before you write</h2>
        <p>
          Allergens, storage, lead times, delivery and pickup are all answered
          on the questions page. If the answer is there, it is quicker than
          waiting for a reply.
        </p>
        <p class="contact__actions">
          <Button href="/faq" variant="secondary">Read the questions</Button>
          <Button href="/legal/allergens" variant="quiet">Allergen statement</Button>
        </p>
      </div>
    </div>
  </article>
</Base>

<style>
  .contact__lede {
    margin-top: 1rem;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--color-crust-soft);
  }

  /* The address is the point of the page, so it is set like a heading
     without being one. */
  .contact__address {
    margin-top: 1.5rem;
  }

  .contact__address-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: var(--leading-snug);
    color: var(--color-link);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;
    /* An email address must never be the thing that causes a sideways
       scroll on a narrow phone. */
    overflow-wrap: anywhere;
  }

  .contact__where {
    margin-top: 1.1rem;
    color: var(--color-crust-soft);
  }

  /* ---- Reasons ---- */

  .reasons {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .reasons__item {
    padding-block: 0.35rem;
    border-top: 1px solid var(--color-line);
  }

  .reasons__item:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .reasons__link {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 44px;
    color: var(--color-crust);
    font-weight: 600;
    text-decoration: none;
  }

  .reasons__link:hover .reasons__label {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .reasons__seed {
    flex: none;
    width: 8px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--color-eggwash);
    transform: rotate(-24deg);
  }

  .reasons__detail {
    margin: 0 0 0.65rem 1.4rem;
    font-size: var(--text-sm);
    color: var(--color-crust-soft);
  }

  .contact__note {
    margin-top: 1.25rem;
    font-size: var(--text-sm);
    color: var(--color-crust-soft);
  }

  /* ---- Lists and notes ---- */

  .contact__list {
    margin: 1rem 0 0;
    padding-left: 1.2rem;
  }

  .contact__list li + li {
    margin-top: 0.45rem;
  }

  .contact__open {
    margin-top: 1.2rem;
    padding: 0.85rem 1rem;
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--color-crust-soft);
  }

  .contact__open-title {
    font-weight: 700;
    color: var(--color-crust);
  }

  section p + p {
    margin-top: 1.1rem;
  }

  /* ---- Foot ---- */

  .contact__foot {
    border-top: 1px solid var(--color-line);
  }

  .contact__foot-title {
    font-size: var(--text-xl);
    margin-bottom: 0.9rem;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
</style>

---
/**
 * What gata is. The hub.
 *
 * This page exists because most of California has not eaten gata and cannot
 * pronounce it, and a person who cannot say a word will not order it. It is
 * also the page most likely to be found from a search, so it is written to be
 * read by a person rather than assembled for a crawler.
 *
 * WHY IT IS A HUB NOW
 *
 * It used to answer four different questions on one URL: what the pastry is,
 * what is in it, how to serve it, how to keep it, and what the other names
 * are. Those are five searches made by five different people, and one URL can
 * only carry one title, one description and one position in a result page.
 * Each of them is now its own page under /gata, and this page is the
 * definition plus the way in. See docs/DECISIONS.md D-008.
 *
 * The old section ids are kept on the cards below, because a fragment never
 * reaches the server and no redirect can catch `/gata#serve-title`. An old
 * link lands here, on the card for the page that section became.
 *
 * Two rules hold here as everywhere. Ingredient names are public and required
 * by law, so they are printed in full on the page that lists them. Amounts,
 * ratios, timings and method are the recipe, and they never enter this
 * repository. Anything else that cannot be known for certain is marked as
 * unanswered rather than guessed at.
 */
import { Image } from "astro:assets";

import Base from "@layouts/Base.astro";
import Button from "@components/Button.astro";
import SeedRule from "@components/SeedRule.astro";
import wide from "@/assets/photos/gata-rows-wide.jpg";
import { business, storeOpen } from "@config/site";
import { GATA_PAGES, gataHref } from "./gata/_pages";

/*
  The cards, in reading order. The four pages under /gata, and then keeping a
  tray, which is answered once on the questions side rather than twice here
  and there. Two pages competing for "how long does gata keep" would split the
  one thing they are both trying to win.
*/
const WAYS_IN = [
  ...GATA_PAGES.map((page) => ({
    href: gataHref(page.slug),
    label: page.label,
    blurb: page.blurb,
    legacyAnchors: page.legacyAnchors,
  })),
  {
    href: "/faq/storage/",
    label: "How to keep a tray",
    blurb:
      "Sealed, at room temperature, out of the sun. How many days it keeps is not settled yet, and the page says so.",
    legacyAnchors: ["keep-title"],
  },
];
---

<Base
  title="What gata is"
  description="Gata is an Armenian pastry: rolled dough with a sweet nut filling, sliced into pieces, washed with egg and topped with sesame. What is in it, and how to say it."
>
  <article class="band gata">
    <div class="page gata__head">
      <div class="prose-col">
        <h1>What gata is</h1>
        <p class="gata__lede">
          Gata is an Armenian pastry: rolled dough with a sweet nut filling,
          sliced into pieces, washed with egg and topped with sesame seeds. It
          is eaten with coffee or tea, at any hour, and it is the only thing
          this bakery makes.
        </p>
        <p class="gata__second">
          Some households call the same pastry nazook, and some call it kata.
          It is sold by the tray rather than by the piece.
        </p>
      </div>

      <figure class="gata__figure">
        <Image
          src={wide}
          alt="Close up of gata on the tray, the cut faces showing nut filling turned inside the dough, sesame seeds caught in the gold egg wash."
          width={860}
          height={600}
          widths={[430, 645, 860]}
          sizes="(min-width: 56rem) 26rem, 90vw"
          loading="eager"
          decoding="async"
        />
        <figcaption>
          The cut face is the thing to look at: filling turned inside the dough,
          not sitting on top of it.
        </figcaption>
      </figure>
    </div>

    <SeedRule density="normal" />

    <section class="page band--tight" aria-labelledby="ways-title">
      <div class="prose-col">
        <h2 id="ways-title" class="gata__ways-title">Where to go from here</h2>
        <p class="gata__ways-lede">
          Five things people want to know, each answered on its own page, so
          the one you needed can be sent to somebody as one link.
        </p>
      </div>

      <ul class="ways prose-col">
        {
          WAYS_IN.map((way) => (
            <li class="ways__item" id={way.legacyAnchors[0]}>
              <h3 class="ways__heading" id={way.legacyAnchors[1]}>
                <a class="ways__link" href={way.href}>
                  {way.label}
                </a>
              </h3>
              <p class="ways__blurb">{way.blurb}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="page gata__foot">
      <div class="prose-col">
        <p>
          Gata is baked in {business.city}, California, and sold inside
          California only.{" "}
          <a href="/story">Hakop is the person baking it</a>.
        </p>
        <p class="gata__actions">
          {
            storeOpen ? (
              <Button href="/shop" variant="primary">
                See the trays
              </Button>
            ) : (
              <Button href="/#waitlist" variant="secondary">
                Tell me when ordering opens
              </Button>
            )
          }
          <Button href={`mailto:${business.email}`} variant="quiet">
            Ask a question
          </Button>
        </p>
      </div>
    </div>
  </article>
</Base>

<style>
  .gata__head {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
  }

  .gata__lede {
    margin-top: 1rem;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
  }

  .gata__second {
    margin-top: 1rem;
    color: var(--color-crust-soft);
  }

  @media (min-width: 56rem) {
    .gata__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    }
  }

  /* ---- Figure ---- */

  .gata__figure {
    margin: 0;
  }

  .gata__figure :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
  }

  .gata__figure figcaption {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    color: var(--color-crust-soft);
    max-width: 40ch;
  }

  /* ---- The way in ---- */

  .gata__ways-title {
    font-size: var(--text-2xl);
  }

  .gata__ways-lede {
    margin-top: 0.4rem;
    color: var(--color-crust-soft);
  }

  .ways {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .ways__item {
    padding-block: 1rem;
    border-top: 1px solid var(--color-line);
    /* An old /gata#serve-title link scrolls here, so leave room above it. */
    scroll-margin-top: 5rem;
  }

  .ways__heading {
    font-size: var(--text-lg);
    /* One seed in the gutter beside each way in, the same mark the rest of
       the site uses, rather than five identical rounded cards. */
    position: relative;
  }

  .ways__heading::before {
    content: "";
    position: absolute;
    left: -1.15rem;
    top: 0.62em;
    width: 7px;
    height: 4px;
    border-radius: 50%;
    background-color: var(--color-eggwash);
    transform: rotate(-24deg);
  }

  @media (max-width: 40rem) {
    .ways__heading::before {
      left: 0;
      top: -0.5rem;
    }

    .ways__heading {
      padding-top: 0.35rem;
    }
  }

  .ways__link {
    display: inline-flex;
    align-items: center;
    /* 44px row, so the question is a real target on a phone. */
    min-height: 44px;
    color: var(--color-link);
    text-decoration: none;
  }

  .ways__link:hover {
    color: var(--color-link-bright);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .ways__blurb {
    margin-top: 0.15rem;
    color: var(--color-crust-soft);
    max-width: 62ch;
  }

  /* ---- Foot ---- */

  .gata__foot {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .gata__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
</style>

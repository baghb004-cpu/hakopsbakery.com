# Dependencies
node_modules/

# Build output
dist/
.astro/
.netlify/
.vercel/
# astro.a11y.config.mjs builds here. It is the same rendered site as dist/,
# including the compliance footer, so a committed copy is a frozen snapshot of
# the registration number that was in the environment when somebody ran it.
.a11y-dist/

# Environment. Never commit a real one.
# .env.example IS committed, deliberately, as documentation.
.env
.env.*
!.env.example

# Test and tooling output
coverage/
*.tsbuildinfo
.vitest/
*.log
npm-debug.log*

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Scratch. Nothing in here is part of the site.
scratch/

# scripts/make-preview.mjs writes here: a rewritten copy of dist/ for viewing
# somewhere that has no server to resolve directory URLs. Generated output, the
# same five megabytes as dist/, and it belongs in a commit no more than dist/
# does. The script is committed. Its output is not.
preview/
*.local

# Throwaway probes written while investigating a bug. A probe that proves
# something real gets promoted into tests/ as a proper named test rather than
# being committed from here.
tests/__probe__/
.probe-*
src/**/__probe_*

# Any other scratch build made while auditing, for example building twice to
# compare the store open and store closed output. 4.8 MB of one such directory
# reached a commit by way of `git add -A`, which is why this is a wildcard and
# not one more named folder.
*-dist/

# Screenshots taken while checking a page. Look at them, then let them go.
/*.png

# Dependencies
node_modules/

# Build output
dist/
.astro/
.netlify/
.vercel/

# Environment. Never commit a real one.
# .env.example IS committed, deliberately, as documentation.
.env
.env.*
!.env.example

# Test and tooling output
coverage/
*.tsbuildinfo
.vitest/
*.log
npm-debug.log*

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Scratch. Nothing in here is part of the site.
scratch/
*.local

# Throwaway probes written while investigating a bug. A probe that proves
# something real gets promoted into tests/ as a proper named test rather than
# being committed from here.
tests/__probe__/

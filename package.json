{
  "name": "hakopsbakery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node scripts/preflight.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:copy": "node scripts/check-copy.mjs",
    "verify": "npm run lint:copy && npm run lint:contrast && npm run check && npm run test && npm run build && npm run lint:html && npm run test:viewports -- --no-build",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint:contrast": "node scripts/check-contrast.mjs",
    "lint:html": "node scripts/check-html.mjs",
    "test:viewports": "node scripts/check-viewports.mjs",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "status": "node scripts/status.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@netlify/functions": "^6.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "node-html-parser": "^9.0.4",
    "playwright": "^1.63.0",
    "stripe": "^22.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}

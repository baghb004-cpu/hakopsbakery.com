# ---------------------------------------------------------------------------
# hakopsbakery.com, environment variables
#
# Copy this file to .env for local work:   cp .env.example .env
#
# .env is ignored by git and must never be committed. This file is committed,
# deliberately, as documentation. Never put a real secret in it.
#
# Nothing here is required to run the site locally. Every value falls back to a
# safe default in src/config/site.ts, the store stays closed, and no analytics
# script loads. Fill in only what you are working on.
#
# In production these are set in the Netlify dashboard, per deploy context.
# Deploy previews keep PUBLIC_STORE_OPEN=false and Stripe test keys.
# The list that must exist before the store can open is docs/LAUNCH.md, C.
# ---------------------------------------------------------------------------


# ===========================================================================
#  READ THIS FIRST: what PUBLIC_ means
# ===========================================================================
#
#   ANYTHING PREFIXED  PUBLIC_  IS VISIBLE TO EVERY VISITOR.
#
# Astro compiles PUBLIC_ variables into the JavaScript and HTML that every
# browser downloads. There is no undo: the moment it deploys, it is public,
# permanently, to anyone who opens devtools or reads the page source.
#
# Use the prefix only for values that are meant to be read by strangers: the
# business name, the registration number, the contact email, a Stripe
# publishable key.
#
# Everything without the prefix is available only to the build and to the
# Netlify functions, and never reaches a browser. Secret keys, service role
# keys, webhook signing secrets and build hook URLs all live there.
#
# scripts/preflight.mjs fails the build if a PUBLIC_ variable looks like a
# secret key or a JWT. Treat that as a last line of defence, not as a policy.


# ===========================================================================
#  PUBLIC. Safe to be seen. Compiled into the browser bundle.
# ===========================================================================

# The canonical origin, no trailing slash. Used for canonical URLs, the
# sitemap, Open Graph tags and absolute links in email.
# Local: leave unset (defaults to https://hakopsbakery.com) or use
# http://localhost:4321 if you are testing absolute links.
PUBLIC_SITE_URL="https://hakopsbakery.com"

# The launch gate. true, 1 or yes opens the store.
# It is ANDed with the compliance check: the store cannot open without a
# registration number even if this is true, and the build will refuse.
# Keep this false in every deploy preview.
PUBLIC_STORE_OPEN="false"


# --- Identity. Must match the county registration and the printed label. ---

# The legal business name, exactly as registered with the county. If these
# disagree, the county registration is right and this is wrong.
PUBLIC_BUSINESS_NAME="Hakop's Bakery"

# The address that appears on the label and in the footer.
# OPEN DECISION, docs/DECISIONS.md D-003. Publishing a home address is a real
# safety and privacy choice and it has not been made. Leave empty until it is:
# empty means the footer shows the city only, which is correct and honest.
# Ask Orange County Environmental Health what the options are, 714-433-6000.
PUBLIC_BUSINESS_ADDRESS=""

# Where customers write. Not a personal address.
PUBLIC_CONTACT_EMAIL="hello@hakopsbakery.com"

# Optional. Deliberately NOT Hakop's personal mobile number. A published phone
# number is permanent. Leave empty until there is a number that can be given
# out safely. See docs/DECISIONS.md, "Still open".
PUBLIC_CONTACT_PHONE=""

# Optional. Handle only, without the @ and without a URL.
PUBLIC_INSTAGRAM_HANDLE=""


# --- Cottage food compliance. docs/COMPLIANCE.md is the source of truth. ---

# Issued by Orange County Environmental Health when the Class A registration
# is granted. PENDING today. The build REFUSES to deploy with the store open
# while this is empty, because a cottage food operation that advertises to the
# public must display its registration number.
# Where to get it: 714-433-6000, EHCottageFood@ochca.com.
PUBLIC_CFO_REGISTRATION_NUMBER=""

# The county that issued the registration. Appears in the compliance line.
PUBLIC_CFO_COUNTY="Orange County"

# ISO date, YYYY-MM-DD. Registration renews annually. The admin compliance
# panel warns at 60 days and again at 30 days before this date.
# Comes back with the registration.
PUBLIC_CFO_EXPIRY=""

# CDTFA seller's permit number, IF one is required for this product mix.
# That is an open question: see the VERIFY list in docs/COMPLIANCE.md.
# Ask CDTFA, not the county. Leave empty until there is an answer in writing.
PUBLIC_SELLERS_PERMIT=""


# --- Third party, public halves only ---

# Stripe publishable key. Public by design: it identifies the account and can
# do nothing on its own. It starts pk_test_ or pk_live_. If a value here starts
# sk_, it is the secret key and it is in the wrong variable.
# Where to get it: Stripe dashboard, Developers, API keys.
# Use the test key everywhere except production.
PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Cloudflare Web Analytics site token. About one kilobyte, no cookies, so no
# consent banner and a short privacy policy. See docs/DECISIONS.md D-002.
# Where to get it: Cloudflare dashboard, Web Analytics, add the site.
# Leave empty on a laptop: no token means no analytics script at all.
PUBLIC_CF_ANALYTICS_TOKEN=""


# ===========================================================================
#  SECRET. Never prefixed PUBLIC_. Never committed. Never sent to a browser.
# ===========================================================================

# --- Stripe ---

# Server side Stripe key, used only inside Netlify functions. Starts sk_test_
# or sk_live_. If this ever appears in a browser bundle, roll it immediately in
# the Stripe dashboard and assume it is compromised.
# Where to get it: Stripe dashboard, Developers, API keys.
STRIPE_SECRET_KEY=""

# Signing secret for the webhook endpoint, starts whsec_. Without it the
# webhook cannot verify that a request really came from Stripe, which means the
# California re validation after payment never runs. That check is the one that
# cannot be bypassed, so this is not optional once the store is open.
# Where to get it: Stripe dashboard, Developers, Webhooks, the endpoint.
# NOTE: live mode and test mode have DIFFERENT signing secrets. Copying the
# test one into production is a common launch day failure.
STRIPE_WEBHOOK_SECRET=""


# --- Commerce ---

# The Class A annual gross sales ceiling, in integer cents. It is adjusted
# annually, which is why it is configuration and not a constant.
# VERIFY the current year figure with the county before trusting the meter.
# Counts product revenue plus shipping revenue. Sales tax collected does not
# count. docs/COMPLIANCE.md, VERIFY list, item 3.
CFO_ANNUAL_CAP_CENTS=""


# --- Transactional email ---

# API key for the service that sends order confirmations, and the explanation
# email to a customer whose order was refunded for a non California address.
# THE VENDOR IS NOT CHOSEN YET. See docs/DECISIONS.md, "Still open". Rename
# this variable to match whichever vendor is picked, and update this comment
# and docs/LAUNCH.md section C at the same time.
ORDER_EMAIL_API_KEY=""


# --- Phase 2: the database and the admin. Nothing below is used today. ---

# Which catalog implementation runs: "file" reads src/content/products/,
# "supabase" reads Postgres. docs/ARCHITECTURE.md section 2. Leave as file
# until the admin exists and the data has been migrated.
CATALOG_SOURCE="file"

# Supabase project URL. Not secret in itself, but it is only ever read server
# side here, so it does not carry the PUBLIC_ prefix.
SUPABASE_URL=""

# Supabase anon key. It is a JWT, and preflight refuses any PUBLIC_ variable
# that looks like a JWT, so it deliberately has no prefix. The admin reads its
# client configuration from a function at runtime rather than from the bundle.
SUPABASE_ANON_KEY=""

# Supabase service role key. This bypasses row level security completely.
# Server side only, always. Never in a browser, never in a PUBLIC_ variable,
# never in a log line. If it leaks, rotate it in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=""

# Netlify build hook URL. The admin calls this after publishing a product so
# the static site rebuilds with the change. Treat it as a secret: anyone who
# has the URL can trigger a build, which is a small denial of service.
# Where to get it: Netlify, Site configuration, Build and deploy, Build hooks.
NETLIFY_BUILD_HOOK_URL=""
